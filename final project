def crop_forms_from_page(image_path, output_dir, page_name,
                          min_area=3000, padding=15, show_preview=False):
    img = cv2.imread(image_path)
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

    _, thresh = cv2.threshold(gray, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)

    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (9, 9))   # smaller kernel
    dilated = cv2.dilate(thresh, kernel, iterations=1)             # fewer iterations

    contours, _ = cv2.findContours(dilated, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    h, w = img.shape[:2]
    saved_count = 0
    preview_img = img.copy()

    for i, cnt in enumerate(contours):
        area = cv2.contourArea(cnt)
        if area < min_area:
            continue

        x, y, cw, ch = cv2.boundingRect(cnt)

        # Skip boxes that are unusually wide/tall relative to page (likely text labels or the whole page)
        box_w_ratio = cw / w
        box_h_ratio = ch / h
        if box_w_ratio > 0.6 or box_h_ratio > 0.6:
            continue

        x1 = max(x - padding, 0)
        y1 = max(y - padding, 0)
        x2 = min(x + cw + padding, w)
        y2 = min(y + ch + padding, h)

        crop = img[y1:y2, x1:x2]

        out_path = os.path.join(output_dir, f"{page_name}_form{saved_count}.jpg")
        cv2.imwrite(out_path, crop)
        saved_count += 1

        if show_preview:
            cv2.rectangle(preview_img, (x1, y1), (x2, y2), (0, 255, 0), 3)

    if show_preview:
        plt.figure(figsize=(10, 12))
        plt.imshow(cv2.cvtColor(preview_img, cv2.COLOR_BGR2RGB))
        plt.title(f"{page_name}: found {saved_count} form(s)")
        plt.axis('off')
        plt.show()

    return saved_count

