def draw_blocks(ax, blocks):
    for b in blocks:
        x, y, z = b["position"]
        dx, dy, dz = b["size"]
        corners = np.array([
            [x, y, z], [x+dx, y, z], [x+dx, y+dy, z], [x, y+dy, z],
            [x, y, z+dz], [x+dx, y, z+dz], [x+dx, y+dy, z+dz], [x, y+dy, z+dz]
        ])
        edges = [(0,1),(1,2),(2,3),(3,0), (4,5),(5,6),(6,7),(7,4), (0,4),(1,5),(2,6),(3,7)]
        for e in edges:
            p1, p2 = corners[e[0]], corners[e[1]]
            ax.plot(*zip(p1, p2), color='black')


def combine_forms(filenames, spacing=1.0):
    combined_blocks = []
    z_cursor = 0.0
    for name in filenames:
        entry = form_db[name]
        for b in entry["blocks"]:
            combined_blocks.append({
                "name": f"{name}_{b['name']}",
                "size": b["size"],
                "position": (b["position"][0], b["position"][1], b["position"][2] + z_cursor)
            })
        max_height = max(b["position"][2] + b["size"][2] for b in entry["blocks"])
        z_cursor += max_height + spacing
    return combined_blocks


